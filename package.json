{
  "name": "vue3-pnpm-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:vue-demo1": "pnpm run -C packages/vue-demo1 dev",
    "dev:vue-demo2": "pnpm run -C packages/vue-demo2 dev",
    "dev:vue-demo3": "pnpm run -C packages/vue-demo3 dev",
    "build:vue-demo1": "pnpm run -C packages/vue-demo1 build",
    "build:vue-demo2": "pnpm run -C packages/vue-demo2 build",
    "build:vue-demo3": "pnpm run -C packages/vue-demo3 build",
    "check:deps": "node scripts/check-deps.js",
    "fix:deps": "node scripts/auto-install-deps.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue3-pnpm-monorepo/my-utils": "workspace:*",
    "typescript": "^5.7.2",
    "vite": "^4.3.9",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT"
}
